#. Plugin Name of the plugin
#: huutokauppa.php
msgid "Huutokauppa"
msgstr "Huutokauppa"

#. Description of the plugin
#: huutokauppa.php
msgid ""
"Stand-alone online auctions: seller submissions, bidding with automatic "
"(proxy) bids, anti-sniping, watch list and winner handling. No WooCommerce "
"required."
msgstr ""
"Fristående nätauktion: säljarnas anmälningar, budgivning med automatiska "
"bud, förlängd budtid, bevakningslista och hantering av vinnare. Kräver inte "
"WooCommerce."

